<?xml version="1.0" encoding="utf-8"?>
<!-- ==================== 视频详情页根布局 ==================== -->
<!-- 整体采用FrameLayout层叠布局，从下到上依次是：背景图 -> 遮罩层 -> 内容区 -->
<FrameLayout android:id="@id/video_detail_layout" android:background="@drawable/background_image"
    android:focusable="false" android:layout_width="fill_parent" android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ==================== 背景层 ==================== -->
    <!-- 视频封面模糊背景图，作为页面底层装饰 -->
    <com.bilibili.tv.widget.ScalableImageView android:id="@id/blur"
        android:layout_width="fill_parent" android:layout_height="fill_parent"
        android:scaleType="fitCenter" />

    <!-- 纯黑半透明遮罩层（已注释，备用） -->
    <!-- <View android:background="@color/black_80" android:layout_width="fill_parent"
        android:layout_height="fill_parent" /> -->

    <!-- 渐变遮罩层，从上到下渐变，使顶部内容更清晰可见 -->
    <View android:id="@id/gradient_mask"
        android:background="@drawable/video_detail_gradient_mask"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

    <!-- ==================== 主内容区 ==================== -->
    <!-- 内容主容器，默认隐藏，数据加载完成后显示 -->
    <!-- paddingTop预留顶部空间给视频封面区域 -->
    <LinearLayout android:orientation="vertical" android:id="@id/content_layout"
        android:paddingTop="@dimen/px_350"
        android:focusable="false" android:visibility="gone" android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <!-- ==================== 可滚动内容区 ==================== -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/px_50"
                android:paddingRight="@dimen/px_70">

                <!-- ==================== 标题区域 ==================== -->
                <!-- 原始标题容器，随页面滚动 -->
                <LinearLayout android:orientation="vertical"
                    android:id="@+id/title_section"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:focusable="false"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:layout_width="fill_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/px_50">

                    <!-- 标题区域：固定高度，标题底部对齐，多行时向上扩展 -->
                    <FrameLayout
                        android:focusable="false"
                        android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/px_300">
                        <LinearLayout android:orientation="horizontal" android:focusable="false"
                            android:layout_gravity="bottom"
                            android:clipChildren="false" android:clipToPadding="false"
                            android:layout_width="fill_parent" android:layout_height="wrap_content">
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_42"
                                android:textColor="@color/white" android:ellipsize="end"
                                android:id="@id/video_detail_title" android:focusable="false"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold" />
                            <View android:layout_width="0dp" android:layout_height="0dp"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- 底部元素：PGC信息容器 + 互动视频标签 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:focusable="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/px_16">
                        <!-- PGC信息容器（番剧评分、类型、地区、更新信息），仅PGC视频显示 -->
                        <LinearLayout android:id="@+id/pgc_info_container"
                            android:orientation="horizontal"
                            android:focusable="false"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <!-- PGC评分 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/pink"
                                android:id="@+id/pgc_rating"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/px_8" />
                            <!-- PGC类型 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/white_50"
                                android:id="@+id/pgc_type"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/px_30" />
                            <!-- PGC地区 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/white_50"
                                android:id="@+id/pgc_area"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/px_30" />
                            <!-- PGC更新信息 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/white_50"
                                android:id="@+id/pgc_new_ep"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/px_30" />
                        </LinearLayout>
                        <!-- 互动视频标签（移到PGC信息容器右侧） -->
                        <TextView android:id="@+id/interaction_video_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/px_30"
                            android:background="@drawable/interaction_video_tag_bg"
                            android:drawableLeft="@drawable/ic_interaction_video"
                            android:drawablePadding="@dimen/px_8"
                            android:focusable="false"
                            android:text="互动视频"
                            android:textColor="@color/white"
                            android:textSize="@dimen/px_24"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 视频统计信息区域 ==================== -->
                <!-- 包含：播放量、弹幕数、时长、上传时间 -->
                <LinearLayout android:orientation="vertical" android:focusable="false"
                    android:clipChildren="true" android:clipToPadding="false"
                    android:layout_width="fill_parent" android:layout_height="wrap_content"
                    >

                    <!-- 视频统计数据行 -->
                    <LinearLayout android:gravity="left|center_vertical"
                        android:id="@id/video_stats"
                        android:focusable="false" android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/px_15">
                        <!-- 播放量标签 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white_50" android:focusable="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/video_detail_play_count" />
                        <!-- 播放量数值 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white"
                            android:id="@id/video_detail_play_count"
                            android:focusable="false" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/px_10"
                            android:layout_marginRight="@dimen/px_60" />
                        <!-- 弹幕数标签 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white_50" android:focusable="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/video_detail_danmaku" />
                        <!-- 弹幕数数值 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white" android:id="@id/video_detail_danmaku"
                            android:focusable="false" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/px_10"
                            android:layout_marginRight="@dimen/px_30" />
                        <!-- 时长标签 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white_50" android:focusable="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="时长:" />
                        <!-- 时长数值 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white" android:id="@id/video_detail_duration"
                            android:focusable="false" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/px_10"
                            android:layout_marginRight="@dimen/px_30" />
                        <!-- 上传时间标签 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white_50" android:focusable="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/video_detail_uptime" />
                        <!-- 上传时间数值 -->
                        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_24"
                            android:textColor="@color/white" android:id="@id/video_detail_uptime"
                            android:focusable="false" android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/px_10"
                            android:layout_marginRight="@dimen/px_30" android:layout_weight="1.0" />
                    </LinearLayout>

                    <!-- ==================== UP主/创作者区域（使用weight限制最多1/3宽度） ==================== -->
                    <LinearLayout android:orientation="horizontal"
                        android:focusable="false"
                        android:layout_width="fill_parent" android:layout_height="wrap_content">
                        <!-- UP主区域（weight=1，最多占1/3宽度） -->
                        <LinearLayout android:gravity="center" android:id="@id/video_uper_container"
                            android:focusable="false" android:clipChildren="true"
                            android:clipToPadding="false"
                            android:layout_width="0.0dip" android:layout_height="wrap_content"
                            android:layout_weight="1.0">
                            <!-- UP主标签 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/white_50" android:focusable="false"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/video_detail_uper" />
                            <!-- UP主名称可水平滚动容器 -->
                            <HorizontalScrollView android:id="@id/video_detail_up_layout"
                                android:focusable="false"
                                android:scrollbars="none"
                                android:clipChildren="true" android:clipToPadding="false"
                                android:layout_width="0.0dip" android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/px_10" android:layout_weight="1.0"
                                android:paddingRight="@dimen/px_20">
                                <!-- 创作者列表容器（支持多UP主联合投稿） -->
                                <LinearLayout android:id="@+id/video_detail_staff_container"
                                    android:orientation="horizontal"
                                    android:focusable="false"
                                    android:clipChildren="false" android:clipToPadding="false"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                </LinearLayout>
                            </HorizontalScrollView>
                        </LinearLayout>
                        <!-- 空白区域（weight=2，占剩余2/3宽度） -->
                        <View android:layout_width="0.0dip" android:layout_height="0.0dip"
                            android:layout_weight="2.0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 操作按钮区域 ==================== -->
                <!-- 包含：播放按钮、点赞、投币、收藏、稍后再看 -->
                <LinearLayout android:orientation="vertical" android:focusable="false"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:layout_width="fill_parent" android:layout_height="wrap_content"
                    android:paddingTop="@dimen/px_10"
                    android:paddingBottom="@dimen/px_30"
                    android:paddingLeft="@dimen/px_10">

                    <LinearLayout android:focusable="false"
                        android:gravity="center_vertical"
                        android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="fill_parent" android:layout_height="wrap_content">

                        <!-- ===== 继续播放按钮（有历史记录时显示） ===== -->
                        <com.bilibili.tv.widget.ProgressPlayButton android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/video_history_play_btn_layout"
                            android:focusable="true" android:focusableInTouchMode="true"
                            android:nextFocusLeft="@id/video_history_play_btn_layout"
                            android:nextFocusRight="@id/video_re_play_btn_layout"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content" android:minWidth="@dimen/px_100"
                            android:layout_height="@dimen/px_80">
                            <!-- 播放图标 -->
                            <ImageView android:id="@+id/video_history_play_img"
                                android:focusable="false"
                                android:background="@drawable/ic_play_arrow_white_48dp"
                                android:layout_width="@dimen/px_48"
                                android:layout_height="@dimen/px_48"
                                android:layout_marginLeft="@dimen/px_20"
                                android:layout_marginRight="@dimen/px_20"
                                android:scaleType="fitCenter" />
                            <!-- 播放按钮文本（如：继续播放） -->
                            <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                android:textColor="@color/white" android:gravity="center"
                                android:id="@+id/video_history_play_btn" android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="@dimen/px_26" />
                            <!-- 播放进度时间 -->
                            <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_28"
                                android:textColor="@color/white"
                                android:id="@+id/video_history_btn_progress"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:layout_marginLeft="@dimen/px_10"
                                android:layout_marginRight="@dimen/px_26" />
                        </com.bilibili.tv.widget.ProgressPlayButton>

                        <!-- ===== 无痕播放按钮（可选功能，默认隐藏） ===== -->
                        <com.bilibili.tv.widget.DrawLinearLayout android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/video_no_history_play_btn_layout"
                            android:background="@drawable/background_white_rect"
                            android:focusable="true" android:focusableInTouchMode="true"
                            android:visibility="gone"
                            android:nextFocusLeft="@id/video_history_play_btn_layout"
                            android:nextFocusRight="@id/video_detail_expand_btn"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content" android:minWidth="@dimen/px_100"
                            android:layout_height="@dimen/px_80"
                            android:layout_marginLeft="@dimen/px_10">
                            <!-- 无痕播放复选框 -->
                            <CheckBox android:id="@+id/video_no_history_play_checkbox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/px_20"
                                android:layout_marginRight="@dimen/px_10"
                                android:scaleX="1.3"
                                android:scaleY="1.3"
                                android:focusable="false" />
                            <!-- 无痕播放按钮文本 -->
                            <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                android:textColor="@color/white" android:gravity="center"
                                android:id="@+id/video_no_history_play_btn"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="@dimen/px_26" />
                        </com.bilibili.tv.widget.DrawLinearLayout>

                        <!-- ===== 重新播放按钮 ===== -->
                        <com.bilibili.tv.widget.DrawLinearLayout android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/video_re_play_btn_layout"
                            android:background="@drawable/background_white_rect"
                            android:focusable="true" android:focusableInTouchMode="true"
                            android:nextFocusLeft="@id/video_history_play_btn_layout"
                            android:nextFocusRight="@id/video_detail_expand_btn"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                            android:layout_height="@dimen/px_80"
                            android:layout_marginLeft="@dimen/px_10">
                            <!-- 重播图标 -->
                            <ImageView android:id="@+id/video_re_play_img"
                                android:background="@drawable/ic_replay"
                                android:layout_width="@dimen/px_44"
                                android:layout_height="@dimen/px_44"
                                android:layout_marginLeft="@dimen/px_18"
                                android:layout_marginRight="@dimen/px_18"
                                android:scaleType="fitCenter" />
                            <!-- 重播文本（默认隐藏） -->
                            <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                android:textColor="@color/white" android:gravity="center"
                                android:id="@+id/video_re_play_btn" android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:layout_marginRight="@dimen/px_18" android:text="重播" />
                        </com.bilibili.tv.widget.DrawLinearLayout>

                        <!-- ===== 互动按钮容器（点赞、投币、收藏、稍后再看） ===== -->
                        <LinearLayout android:id="@+id/video_action_buttons_container"
                            android:orientation="horizontal"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:layout_marginLeft="@dimen/px_20"
                            android:clipChildren="false" android:clipToPadding="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content">

                            <!-- 展开按钮（箭头） -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@id/video_detail_expand_btn"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_re_play_btn_layout"
                                android:nextFocusRight="@id/video_detail_like"
                                android:clipToPadding="false"
                                android:layout_width="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <ImageView
                                    android:background="@drawable/ic_right_arrow"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:scaleType="fitCenter" />
                            </com.bilibili.tv.widget.DrawLinearLayout>

                            <!-- 点赞按钮 -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal" android:id="@id/video_detail_like"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_detail_expand_btn"
                                android:nextFocusRight="@id/video_detail_coin"
                                android:clipToPadding="false"
                                android:visibility="gone"
                                android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <!-- 点赞图标 -->
                                <ImageView android:id="@id/video_detail_like_img"
                                    android:background="@drawable/ic_like"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:layout_marginLeft="@dimen/px_18"
                                    android:layout_marginRight="@dimen/px_18"
                                    android:scaleType="fitCenter" />
                                <!-- 点赞文本（默认隐藏） -->
                                <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                    android:textColor="@color/white" android:gravity="center"
                                    android:id="@id/video_detail_like_text"
                                    android:focusable="false"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:visibility="gone"
                                    android:layout_marginRight="@dimen/px_18" android:text="点赞" />
                            </com.bilibili.tv.widget.DrawLinearLayout>

                            <!-- 投币按钮 -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal" android:id="@id/video_detail_coin"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_detail_like"
                                android:nextFocusRight="@id/video_detail_favorite"
                                android:clipToPadding="false"
                                android:visibility="gone"
                                android:layout_marginLeft="@dimen/px_10"
                                android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <!-- 投币图标 -->
                                <ImageView android:id="@id/video_detail_coin_img"
                                    android:background="@drawable/ic_coin"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:layout_marginLeft="@dimen/px_18"
                                    android:layout_marginRight="@dimen/px_18"
                                    android:scaleType="fitCenter" />
                                <!-- 投币文本（默认隐藏） -->
                                <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                    android:textColor="@color/white" android:gravity="center"
                                    android:id="@id/video_detail_coin_text"
                                    android:focusable="false"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:visibility="gone"
                                    android:layout_marginRight="@dimen/px_18" android:text="投币" />
                            </com.bilibili.tv.widget.DrawLinearLayout>

                            <!-- 收藏按钮（支持长按弹出收藏夹菜单） -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@id/video_detail_favorite"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_detail_coin"
                                android:nextFocusRight="@id/video_detail_watch_later"
                                android:clipToPadding="false"
                                android:visibility="gone"
                                android:layout_marginLeft="@dimen/px_10"
                                android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <!-- 收藏图标 -->
                                <ImageView android:id="@id/video_detail_favorite_img"
                                    android:background="@drawable/ic_favorite"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:layout_marginLeft="@dimen/px_18"
                                    android:layout_marginRight="@dimen/px_18"
                                    android:scaleType="fitCenter" />
                                <!-- 收藏文本 -->
                                <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                    android:textColor="@color/white" android:gravity="center"
                                    android:id="@id/video_detail_favorite_text"
                                    android:focusable="false"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="@dimen/px_18" android:text="收藏" />
                            </com.bilibili.tv.widget.DrawLinearLayout>

                            <!-- 稍后再看按钮 -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@id/video_detail_watch_later"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_detail_favorite"
                                android:nextFocusRight="@id/video_detail_info"
                                android:clipToPadding="false"
                                android:visibility="gone"
                                android:layout_marginLeft="@dimen/px_10"
                                android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <!-- 稍后再看图标 -->
                                <ImageView android:id="@id/video_detail_watch_later_img"
                                    android:background="@drawable/ic_hourglass_empty_white_48dp"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:layout_marginLeft="@dimen/px_18"
                                    android:layout_marginRight="@dimen/px_18"
                                    android:scaleType="fitCenter" />
                                <!-- 稍后再看文本 -->
                                <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                    android:textColor="@color/white" android:gravity="center"
                                    android:id="@id/video_detail_watch_later_text"
                                    android:focusable="false"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="@dimen/px_18" android:text="稍后" />
                            </com.bilibili.tv.widget.DrawLinearLayout>

                            <!-- 简介按钮 -->
                            <com.bilibili.tv.widget.DrawLinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@id/video_detail_info"
                                android:background="@drawable/background_white_rect"
                                android:focusable="true" android:focusableInTouchMode="true"
                                android:nextFocusLeft="@id/video_detail_watch_later"
                                android:nextFocusRight="@id/video_detail_info"
                                android:clipToPadding="false"
                                android:visibility="gone"
                                android:layout_marginLeft="@dimen/px_10"
                                android:layout_width="wrap_content" android:minWidth="@dimen/px_80"
                                android:layout_height="@dimen/px_80">
                                <!-- 简介图标 -->
                                <ImageView android:id="@id/video_detail_info_img"
                                    android:background="@drawable/ic_info"
                                    android:layout_width="@dimen/px_44"
                                    android:layout_height="@dimen/px_44"
                                    android:layout_marginLeft="@dimen/px_18"
                                    android:layout_marginRight="@dimen/px_18"
                                    android:scaleType="fitCenter" />
                                <!-- 简介文本 -->
                                <com.bilibili.tv.widget.DrawTextView android:textSize="@dimen/px_36"
                                    android:textColor="@color/white" android:gravity="center"
                                    android:id="@id/video_detail_info_text"
                                    android:focusable="false"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="@dimen/px_18" android:text="简介" />
                            </com.bilibili.tv.widget.DrawLinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 分P列表区域 ==================== -->
                <!-- 视频的分P选集列表 -->
                <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_36"
                    android:textColor="@color/white" android:id="@id/video_detail_ep_title"
                    android:focusable="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" android:maxLines="1" />
                <!-- 分P列表RecyclerView -->
                <android.support.v7.widget.RecyclerView android:id="@id/video_detail_ep_layout"
                    android:paddingTop="@dimen/px_24"
                    android:paddingBottom="@dimen/px_24"
                    android:paddingLeft="@dimen/px_10"
                    android:focusable="true"
                    android:nextFocusLeft="@id/video_detail_ep_layout"
                    android:nextFocusRight="@id/video_detail_ep_layout"
                    android:clipChildren="false"
                    android:clipToPadding="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />

                <!-- ==================== 多合集列表容器 ==================== -->
                <!-- 用于显示PGC番剧的多季/多合集 -->
                <LinearLayout android:id="@+id/video_detail_seasons_container"
                    android:orientation="vertical"
                    android:focusable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />

                <!-- ==================== 合集列表区域 ==================== -->
                <!-- UGC视频的合集选集列表 -->
                <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_36"
                    android:textColor="@color/white" android:id="@id/video_detail_episodes_title"
                    android:focusable="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" android:maxLines="1" />
                <!-- 合集列表RecyclerView -->
                <android.support.v7.widget.RecyclerView android:id="@id/video_detail_episodes_video"
                    android:paddingTop="@dimen/px_24"
                    android:paddingBottom="@dimen/px_24"
                    android:paddingLeft="@dimen/px_10"
                    android:focusable="true"
                    android:nextFocusLeft="@id/video_detail_episodes_video"
                    android:nextFocusRight="@id/video_detail_episodes_video"
                    android:clipChildren="false"
                    android:clipToPadding="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />

                <!-- ==================== 相关推荐区域 ==================== -->
                <!-- 相关视频推荐列表 -->
                <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_36"
                    android:textColor="@color/white" android:id="@id/video_detail_relate_title"
                    android:focusable="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" android:maxLines="1"
                    android:text="相关推荐" />
                <!-- 相关推荐列表RecyclerView -->
                <android.support.v7.widget.RecyclerView android:id="@id/video_detail_relate_video"
                    android:paddingTop="@dimen/px_24"
                    android:paddingBottom="@dimen/px_10"
                    android:paddingLeft="@dimen/px_10"
                    android:focusable="true"
                    android:nextFocusLeft="@id/video_detail_relate_video"
                    android:nextFocusRight="@id/video_detail_relate_video"
                    android:clipChildren="false"
                    android:clipToPadding="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />

                <!-- ==================== 视频简介区域 ==================== -->
                <!-- 视频描述信息容器 -->
                <!-- <LinearLayout android:orientation="vertical" android:focusable="false"
                    android:id="@id/video_detail_des_layout"
                    android:layout_width="fill_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/px_10"> -->
                    <!-- 视频简介标题 -->
                    <!-- <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_36"
                        android:textColor="@color/white" android:id="@id/video_info_describe_title"
                        android:focusable="false" android:layout_width="fill_parent"
                        android:layout_height="wrap_content" android:maxLines="1" /> -->
                    <!-- 视频简介内容 -->
                    <!-- <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_32"
                        android:textColor="@color/white_50" android:id="@id/video_info_describe"
                        android:focusable="false" android:layout_width="fill_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/px_10" /> -->
                <!-- </LinearLayout> -->

                <!-- ==================== 标签列表区域 ==================== -->
                <!-- 视频标签，可点击搜索相关内容 -->
                <android.support.v7.widget.RecyclerView android:id="@id/flow_tag_view"
                    android:paddingTop="@dimen/px_6"
                    android:paddingBottom="@dimen/px_10"
                    android:paddingLeft="@dimen/px_10"
                    android:focusable="true"
                    android:nextFocusLeft="@id/flow_tag_view"
                    android:nextFocusRight="@id/flow_tag_view"
                    android:clipChildren="false"
                    android:clipToPadding="false" android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
