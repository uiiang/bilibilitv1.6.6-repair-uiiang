<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="fill_parent"
  android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
  <com.bilibili.tv.widget.ScalableImageView android:id="@id/iv_loading_cover" android:layout_width="fill_parent"
    android:layout_height="fill_parent" android:scaleType="centerCrop"
    android:background="@color/loading_background" />
  <LinearLayout android:gravity="bottom|right" android:orientation="horizontal"
    android:layout_width="fill_parent" android:layout_height="fill_parent"
    android:paddingRight="@dimen/px_40" android:paddingBottom="@dimen/px_80">
    <View android:layout_width="0dp" android:layout_height="0dp"
      android:layout_weight="6" />
    <LinearLayout android:orientation="vertical"
      android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="4"
      android:background="#80000000" android:padding="@dimen/px_20">
      <TextView android:textSize="@dimen/px_40" android:textColor="@color/white"
        android:gravity="left" android:id="@id/tv_loading" android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2" />
      <TextView android:textSize="@dimen/px_30" android:textColor="@color/white"
        android:gravity="left" android:id="@id/tv_loading_page" android:layout_width="fill_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/px_10"
        android:maxLines="2" android:lineSpacingMultiplier="1.2"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>