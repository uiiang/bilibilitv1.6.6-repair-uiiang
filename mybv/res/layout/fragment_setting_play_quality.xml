            android:background="@drawable/shape_rectangle_trans_with_12corner_white_10"
            android:focusable="true"
            android:nextFocusLeft="@id/decode_ijk_hard"
            android:nextFocusRight="@id/decode_ijk_soft"
            android:nextFocusUp="@id/ijk_player"
            android:nextFocusDown="@id/codec_button"
            android:layout_width="@dimen/px_330"
            android:layout_height="@dimen/px_96"
            android:layout_marginLeft="@dimen/px_40">
            <com.bilibili.tv.widget.ShadowTextView
