    <LinearLayout
        android:gravity="left|center_vertical"
        android:orientation="horizontal"
        android:focusable="false"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/px_150"
        android:layout_marginLeft="@dimen/px_30">
        <com.bilibili.tv.widget.ShadowTextView android:textSize="@dimen/px_44"
            android:textColor="@color/white" android:focusable="false"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/px_30"
            android:layout_marginRight="@dimen/px_30"
            android:text="直播播放器" />
        <com.bilibili.tv.widget.DrawFrameLayout android:id="@id/live_ijk_player"
            android:background="@drawable/shape_rectangle_trans_with_12corner_white_10"
            android:focusable="true"
            android:nextFocusUp="@id/low_quality" android:nextFocusDown="@id/ijk_player"
            android:nextFocusRight="@id/live_exo_player"
            android:layout_width="@dimen/px_330"
            android:paddingLeft="@dimen/px_30"
            android:paddingRight="@dimen/px_30"
